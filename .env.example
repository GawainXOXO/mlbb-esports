# Salin menjadi .env untuk dev LOKAL:  cp .env.example .env
# .env TIDAK PERNAH masuk git atau image Docker. Berkas ini hanya berisi nilai contoh, bukan rahasia asli.
# Rahasia produksi disimpan di pengaturan Vercel dan GitHub Actions secrets.

# --- Database lokal (kontainer Docker, port host 5433). Di dalam Compose ditimpa menjadi @db:5432.
DATABASE_URL=postgres://mlbb:mlbb@localhost:5433/mlbb
DATABASE_URL_DIRECT=postgres://mlbb:mlbb@localhost:5433/mlbb
# Uji lokal: WAJIB database yang namanya berakhiran _test.
TEST_DATABASE_URL=postgres://mlbb:mlbb@localhost:5433/mlbb_test

APP_BASE_URL=http://localhost:3000
TZ=UTC

# --- Login admin (M3). Isi BETTER_AUTH_SECRET dengan nilai acak di .env, jangan di sini.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
# Hanya berlaku bila NODE_ENV=development.
DEV_ADMIN_BYPASS=true
REVALIDATE_SECRET=

# --- Sumber data Rone Arena (M1)
# robots.txt Rone melarang bot di /api/. Karena itu:
#  - RONE_MANUAL_PULL=on menyalakan tombol "Tarik data" di /admin/rone (satu klik = satu permintaan).
#    Selalu mati di produksi sampai login admin selesai (M3).
#  Tidak ada job terjadwal untuk Rone; semua sinkronisasi dipicu manual.
RONE_MANUAL_PULL=on
RONE_API_BASE_URL=
RONE_USER_AGENT=mlbb-esports (non-commercial esports stats; github.com/GawainXOXO/mlbb-esports)
RONE_MIN_INTERVAL_MS=2000
RONE_LEAGUE=id
RONE_TOURNAMENT_SLUG=mpl-id-s18
RONE_TOURNAMENT_NAME=MPL ID Season 18
LPDB_API_KEY=

# --- Penyimpanan gambar
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

ALERT_WEBHOOK_URL=
