#!/bin/sh
# Menolak commit bila ada rahasia di perubahan yang di-stage. Butuh Docker Desktop menyala.
# Aktifkan sekali per klon:  git config core.hooksPath .githooks
if ! docker info >/dev/null 2>&1; then
  echo "pre-commit: Docker tidak menyala, commit ditahan. Nyalakan Docker Desktop lalu ulangi." >&2
  exit 1
fi
# Git Bash di Windows: pakai path gaya C:/... dan matikan konversi path otomatis.
REPO="$(pwd -W 2>/dev/null || pwd)"
export MSYS_NO_PATHCONV=1
exec docker run --rm -v "$REPO:/repo" -w /repo ghcr.io/gitleaks/gitleaks:v8.30.1 \
  git --staged --config /repo/.gitleaks.toml --redact --no-banner /repo
